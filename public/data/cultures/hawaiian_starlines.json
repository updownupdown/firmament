{"id":"hawaiian_starlines","name":"Hawaiian","region":"Oceania","intro":"These are the star lines developed by Nainoa Thompson and used by the Polynesian Voyaging Society to navigate Polynesian sailing canoes using traditional techniques of non instrument navigation across thousands of miles of open ocean.","license":"CC BY-SA","authors":"This sky culture was contributed in 2017 by teachers Darren Kamalu and Christopher Blake, Students Jonah Apo, Nicholas Koanui, Brenden Aila and the Celestial Navigation class at Kamehameha Schools Kapalama, Honolulu, Hawai’i. Artwork by Kealoha Kaneakua. Reworked by Susanne M Hoffmann.","source":"https://github.com/Stellarium/stellarium-skycultures/tree/master/hawaiian_starlines","constellations":[{"id":"KOM","name":"The Canoe Bailer of Makali`i","lines":[[0,7,17,24,42,107,28,112,5,42],[0,48,1]],"native":"Ke Ka o Makali’i"},{"id":"KHK","name":"The Cat's Cradle","lines":[[9,32,57,6,74,27,9],[32,30,74]],"native":"Ka Hei-Hei o Na Keiki"},{"id":"MAK","name":"The Chief's Eyes","lines":[[372,2681]],"native":"Makali`i"},{"id":"MEE","name":"Voice of Joy","lines":[[165,101,182,108,165]],"native":"Me`e"},{"id":"NAH","name":"The Seven","lines":[[39,70,34,239,37,81,86,239]],"native":"Na Hiku"},{"id":"IWI","name":"The Backbone","lines":[[47,37],[39,2,15],[165,15],[1918,25]],"native":"Ka Iwikuamo’o"},{"id":"MAN","name":"The Chief's Fishline","lines":[[26,84,172,41,240,1135,177,78,136,16,159,77],[98,77,157]],"native":"Manaiakalani"},{"id":"NAV","name":"Navigator's Triangle","lines":[[20,11,4,20],[186,149,71,92,20,71]]},{"id":"LUP","name":"Kite of Kawelo","lines":[[55,88,93,138,55],[18,93],[75,55],[52,85],[138,52],[88,2644]],"native":"Ka Lupe o Kawelo"},{"id":"IWA","name":"Chief Frigate Bird","lines":[[246,109,64,72,75]],"native":"`Iwa Keli`i"},{"id":"HAN","name":"Cared for by Moon","lines":[[25,12],[19,130]],"native":"Hanaiakamalama"},{"id":"NAK","name":"The Pointers","lines":[[3,10]],"native":"Nakuhikuhi"},{"id":"KAO","name":"Leo","lines":[[63,9